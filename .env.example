# Google service account con acceso Editor al spreadsheet (client_email del JSON de la key)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# private_key del JSON de la key, PEM completo con \n escapados en una sola línea
GOOGLE_PRIVATE_KEY=

# ID del spreadsheet, de la URL de EDICION: /spreadsheets/d/<ID>/edit  (NO el token 2PACX del CSV publicado)
SHEETS_SPREADSHEET_ID=

# Acceso a customproof.es/admin: un único usuario
ADMIN_USER=
# Contraseña larga (12+ caracteres)
ADMIN_PASSWORD=
# Clave para firmar la cookie de sesión, 32+ caracteres al azar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Cambiarla cierra todas las sesiones abiertas
ADMIN_SECRET=
