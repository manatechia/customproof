# Stripe (Developers -> API keys, modo test: sk_test_...)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (Developers -> Webhooks -> endpoint /api/stripe-webhook -> whsec_...)
# En local lo imprime `stripe listen --forward-to localhost:3000/api/stripe-webhook`
STRIPE_WEBHOOK_SECRET=

# Google service account con acceso Editor al spreadsheet (client_email del JSON de la key)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# private_key del JSON de la key, PEM completo con \n escapados en una sola línea
GOOGLE_PRIVATE_KEY=

# ID del spreadsheet, de la URL de EDICION: /spreadsheets/d/<ID>/edit  (NO el token 2PACX del CSV publicado)
SHEETS_SPREADSHEET_ID=

# Opcional: URL canonica del sitio para success/cancel de Stripe (fallback: header Origin)
SITE_URL=
